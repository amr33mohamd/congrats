# Copy to .env (docker compose) or .env.local (next dev) and fill in.
# In production (NODE_ENV=production) the server validates this at boot
# (lib/env.ts): REQUIRED vars missing → it prints every problem and exits;
# OPTIONAL vars missing → a warning per feature that is switched off.
# Local dev needs none of this — everything below has a dev fallback.

# ── Database ── REQUIRED in production ─────────────────────────────────────
# Leave DATABASE_URL UNSET for local/dev/test → the app uses in-process PGlite
# (offline, no network). Set it to a Postgres URL in production.
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Where PGlite persists data in dev. Use 'memory://' for ephemeral test runs.
PGLITE_PATH=".data/pglite"

# Production without DATABASE_URL is refused unless you opt in to the
# single-container PGlite demo (docker-compose.yml does this for you).
# ALLOW_PGLITE_IN_PRODUCTION="true"

# ── Auth.js ── REQUIRED in production ──────────────────────────────────────
# Generate with: openssl rand -base64 32   (≥ 32 chars; placeholders like the
# one below are rejected in production). The Docker entrypoint generates and
# persists one if unset — set it explicitly when running several instances.
AUTH_SECRET="dev-secret-change-me-in-prod-0000000000000000000000"
# Public base URL of the app. On Render/Fly the entrypoint defaults it to the
# platform URL; set it explicitly for a custom domain.
AUTH_URL="http://localhost:3000"
# Trust the X-Forwarded-* headers of the platform proxy.
# AUTH_TRUST_HOST="true"

# One-tap sign-in (optional). Each button appears only when BOTH its id and
# secret are set. Setup steps: docs/oauth-setup.md
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_FACEBOOK_ID=""
# AUTH_FACEBOOK_SECRET=""

# Email that becomes the seeded admin; password is generated if unset.
SEED_ADMIN_EMAIL="admin@congrats.dev"
# SEED_ADMIN_PASSWORD=""
# The seed runs on every container boot. Set to 1 for ONE boot to archive
# published templates whose slug is no longer in content/templates (this also
# archives templates created in the admin UI). Off by default.
# SEED_ARCHIVE_UNLISTED="1"

# ── Rate limiting ───────────────────────────────────────────────────────────
# How many reverse proxies sit in front of the app. The client IP used for
# rate limits is the X-Forwarded-For entry this many places from the RIGHT
# (the left-most entry is client-controlled). Default 1 (Render, nginx, etc.).
# On Fly.io the Fly-Client-IP header is used automatically. Use 0 when the app
# is exposed directly with no proxy (XFF is then ignored).
# TRUSTED_PROXY_HOPS="1"

# ── Payments ── REQUIRED in production ─────────────────────────────────────
# InstaPay handle shown to buyers (snapshotted onto each order at creation).
INSTAPAY_HANDLE="congrats@instapay"

# ── Storage (StorageAdapter) ───────────────────────────────────────────────
# 'local' (writes to .data/uploads) for dev; 'r2' in prod.
STORAGE_DRIVER="local"
# Local disk root for the dev adapter.
LOCAL_STORAGE_ROOT=".data/uploads"

# R2 (production only) — consumed by the future R2 StorageAdapter.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_EXPERIENCE_MEDIA="experience-media"
# R2_BUCKET_PAYMENT_PROOFS="payment-proofs"

# ── Email ── optional ──────────────────────────────────────────────────────
# Without a key, password-reset links are only logged server-side.
# RESEND_API_KEY=""
# EMAIL_FROM="Congrats <no-reply@yourdomain.com>"

# ── Legal / contact details ── optional (warned about in production) ───────
# Shown on the privacy/terms/refunds/contact pages. BUILD-TIME: NEXT_PUBLIC_*
# values are inlined when `next build` runs — rebuild after changing them.
# The "draft — review with a lawyer" banner disappears only once company name,
# support email and business address are all set. See lib/site.ts.
# NEXT_PUBLIC_COMPANY_NAME=""
# NEXT_PUBLIC_SUPPORT_EMAIL=""
# NEXT_PUBLIC_BUSINESS_ADDRESS=""
# NEXT_PUBLIC_SUPPORT_WHATSAPP=""          # e.g. 201001234567 (digits only)
# Canonical origin for sitemap/canonical/OG URLs (falls back to AUTH_URL).
# NEXT_PUBLIC_SITE_URL="https://congrats.example.com"
# Policy overrides shown on the legal pages (defaults in lib/site.ts):
# NEXT_PUBLIC_RESPONSE_TIME_EN="1–2 business days"   NEXT_PUBLIC_RESPONSE_TIME_AR=""
# NEXT_PUBLIC_REVIEW_WINDOW_EN="24 hours"            NEXT_PUBLIC_REVIEW_WINDOW_AR=""
# NEXT_PUBLIC_REFUND_WINDOW_DAYS="7"
# NEXT_PUBLIC_REFUND_PROCESSING_EN="5–7 business days" NEXT_PUBLIC_REFUND_PROCESSING_AR=""
# NEXT_PUBLIC_GOVERNING_LAW_EN="Egypt"               NEXT_PUBLIC_GOVERNING_LAW_AR=""

# ── Error tracking (Sentry) ── optional ────────────────────────────────────
# Unset = Sentry is fully off (not initialised, not wired into the build).
# The DSN is needed at BUILD time too (browser SDK + CSP) and at runtime (server).
# SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# SENTRY_ENVIRONMENT="production"
# Fraction of requests to trace (0–1). Default 0 = errors only.
# SENTRY_TRACES_SAMPLE_RATE="0"
# Source-map upload at build time — only happens when the token is set.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# ── Analytics (Plausible) ── optional ──────────────────────────────────────
# Cookie-less, privacy-friendly. BUILD-TIME. Unset = no analytics script.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="congrats.example.com"
# Self-hosted Plausible? Point at it (default https://plausible.io).
# NEXT_PUBLIC_PLAUSIBLE_HOST="https://plausible.io"

# Meta (Facebook) Pixel id from Events Manager, digits only. Optional: our own
# event log (Admin → Analytics) works without it. Needed at build time.
# NEXT_PUBLIC_META_PIXEL_ID="123456789012345"

# ── Content-Security-Policy ── BUILD-TIME ──────────────────────────────────
# The full CSP ships as Report-Only by default. Set to true to enforce it once
# a browser pass shows no violations (see DEPLOY.md → Security headers).
# CSP_ENFORCE="true"

# Owner alerts (new sign-up, payment waiting for approval). Falls back to
# SEED_ADMIN_EMAIL. Needs RESEND_API_KEY to actually send.
# ADMIN_NOTIFY_EMAIL="you@example.com"
